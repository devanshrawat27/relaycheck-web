# RelayCheck Dashboard - placeholder values only.
# Copy to .env.local before overriding anything.

# Server-side base URL of the Control API (never called from the browser).
CONTROL_API_URL=http://localhost:3200

# Optional: must match the Control API's API_AUTH_TOKEN when that is set.
API_AUTH_TOKEN=

# Diagnostics page probes this receiver (server-side).
DEMO_RECEIVER_URL=http://127.0.0.1:3100
